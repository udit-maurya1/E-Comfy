# Copy to .env and fill in. The server refuses to boot if any required
# variable is missing — see src/config/config.js.

# ── Core ──────────────────────────────────────────────────────────────
PORT=8080
MONGO_URI=mongodb://localhost:27017/ecomfy
JWT_SECRET=replace-with-a-long-random-string

# development | production. In production the session cookie becomes
# secure + sameSite=none, and CLIENT_URL below stops being optional.
NODE_ENV=development

# Browser origin this API serves — drives CORS, OAuth redirects and cookies.
CLIENT_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:8080/api/auth/google/callback

# ── ImageKit (product media) ──────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Razorpay ──────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys in development.
RAZOR_PAY_KEY=rzp_test_xxxxxxxxxxxx
RAZOR_PAY_SECRET=

# Dashboard → Settings → Webhooks. Point the webhook at
# <your-public-url>/api/payment/webhook and subscribe to
# payment.captured, payment.failed and refund.processed.
# Without this, webhook calls are rejected and only the browser callback
# confirms payments — fine locally, not safe in production.
RAZOR_PAY_WEBHOOK_SECRET=

# ── Storefront rules (optional — see src/config/commerce.js) ──────────
# CURRENCY=INR
# SHIPPING_FEE=99
# FREE_SHIPPING_THRESHOLD=999
# TAX_RATE=0
# MAX_ADDRESSES_PER_USER=10
# MAX_WISHLIST_ITEMS=100
